# ── Base de datos ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cocos
DB_USER=cocos
DB_PASSWORD=cocos

# ── Postgres (usado por el servicio docker de postgres) ────
POSTGRES_DB=cocos
POSTGRES_USER=cocos
POSTGRES_PASSWORD=cocos

# ── Aplicación ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── New Relic (opcional — dejar vacío para deshabilitar) ───
NEW_RELIC_APP_NAME=cocos-challenge
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_NO_CONFIG_FILE=true
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
NEW_RELIC_LOG_LEVEL=info
